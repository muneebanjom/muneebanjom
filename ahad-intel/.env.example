# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ahad_intel?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Session signing key. REQUIRED in production, minimum 32 characters.
#   openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-32+chars"

# Encryption key for contact PII and integration credentials (AES-256-GCM).
# REQUIRED in production. Must decode to exactly 32 bytes.
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# Shared secret for the cron endpoints. Leave unset to disable them.
#   openssl rand -base64 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# AI provider (optional — the platform is fully functional without it)
# ---------------------------------------------------------------------------
# "heuristic" (default, deterministic, offline) or "anthropic".
AI_PROVIDER="heuristic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
# Lusha and Apollo credentials are NOT set here: each workspace supplies its own
# key through Settings → Integrations, and it is encrypted before storage.
#
# LinkedIn is only enabled if your organisation operates an approved LinkedIn
# application. Leave unset to keep the API connector inert; user-provided
# exports and manual research work without it.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Jobs & seeding
# ---------------------------------------------------------------------------
JOB_POLL_INTERVAL_MS="5000"
# Password for the seeded demo users. Development only.
SEED_PASSWORD="AhadDemo!2025"
